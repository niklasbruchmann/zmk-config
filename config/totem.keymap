#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        no_hrm_toggle {
            bindings = <&to 3>;
            key-positions = <32 33 34>;
            layers = <0>;
        };

        base_toggle {
            bindings = <&to 0>;
            key-positions = <37 36 35>;
            layers = <3>;
        };
    };

    macros {
        mac_screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(LC(NUMBER_4)))>;
            label = "SCREENSHOT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
            &kp Q       &kp W       &kp E          &kp R        &kp T        &kp Y    &kp U        &kp I            &kp O         &kp P
            &kp A       &kp S       &kp D          &kp F        &kp G        &kp H    &kp J        &kp K            &kp L         &kp SEMI
&kp ESCAPE  &hm LGUI Z  &hm LALT X  &kp C          &hm LSHFT V  &kp B        &kp N    &hm RSHFT M  &kp COMMA        &hm RALT DOT  &hm RGUI SLASH  &kp APOSTROPHE
                                    &mt LCTRL DEL  &lt 1 TAB    &kp SPACE    &kp RET  &lt 2 BSPC   &mt RCTRL MINUS
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
                 &kp TILDE       &hm F10 F7  &hm F11 F8  &hm F12 F9  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
                 &kp LEFT_SHIFT  &kp F4      &kp F5      &kp F6      &kp LEFT_BRACE      &kp RIGHT_BRACE    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&mac_screenshot  &kp LEFT_WIN    &kp F1      &kp F2      &kp F3      &kp LPAR            &kp RPAR           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &kp PLUS
                                             &trans      &trans      &trans              &trans             &trans        &kp DOT
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
                &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET       &kp AMPERSAND  &kp KP_ASTERISK  &kp GRAVE        &trans
                &trans    &trans  &trans    &trans      &trans         &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW     &kp RIGHT_ARROW  &trans
&studio_unlock  &trans    &trans  &trans    &trans      &trans         &kp UNDER       &kp EQUAL      &kp BACKSLASH    &trans           &kp SLASH  &kp HOME
                                  &trans    &trans      &trans         &trans          &trans         &trans
            >;
        };

        no_hrm {
            display-name = "No homerow mods";
            bindings = <
         &kp Q  &kp W  &kp E      &kp R    &kp T        &kp Y      &kp U          &kp I      &kp O       &kp P
         &kp A  &kp S  &kp D      &kp F    &kp G        &kp H      &kp J          &kp K      &kp L       &kp SEMICOLON
&kp ESC  &kp Z  &kp X  &kp C      &kp V    &kp B        &kp N      &kp M          &kp COMMA  &kp PERIOD  &kp SLASH      &kp SQT
                       &kp LCTRL  &kp TAB  &kp SPACE    &kp ENTER  &kp BACKSPACE  &kp MINUS
            >;
        };

        Gaming {
            display-name = "Game";
            bindings = <
            &kp Z           &kp X  &kp C      &kp V         &sl 5     &trans  &trans  &trans  &trans  &trans
            &kp TAB         &kp Q  &kp W      &kp E         &kp R     &trans  &trans  &trans  &trans  &trans
&kp ESCAPE  &kp LEFT_SHIFT  &kp A  &kp S      &kp D         &kp F     &trans  &trans  &trans  &trans  &trans  &trans
                                   &kp LCTRL  &kp LEFT_ALT  &trans    &trans  &trans  &trans
            >;
        };

        Gaming+ {
            display-name = "Game+";
            bindings = <
        &kp F10  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp T     &kp RA(RC(Y))  &kp RA(RC(U))  &trans  &trans  &kp LC(RA(DEL))
        &kp L    &kp O         &kp Y         &kp K         &kp G     &kp F5         &kp F7         &trans  &trans  &kp F12
&trans  &to 0    &trans        &trans        &trans        &trans    &trans         &trans         &trans  &trans  &kp F22          &kp LA(F4)
                               &kp J         &kp I         &kp M     &trans         &trans         &trans
            >;
        };
    };
};
